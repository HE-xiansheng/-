<launch>
    <!-- 机载无人机 EGO-Planner 启动入口 (针对 Orange Pi 5 Ultra, RK3588, MID360 激光雷达) -->
    <arg name="drone_id" default="0"/>
    <arg name="manual_preview" default="true"/>
    <arg name="map_resolution" default="0.10"/>
    <arg name="odom_topic" default="/factory_fastlio/odometry"/>
    <arg name="cloud_topic" default="/factory_fastlio/cloud_world"/>
    <arg name="lidar_p_miss" default="0.40"/>
    <arg name="odom_vel_is_body" default="true"/>
    <arg name="output_cmd_topic" default="/ego_planner/pos_cmd"/>

    <include file="$(find ego_planner)/launch/include/advanced_param_exp.xml">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="manual_preview" value="$(arg manual_preview)"/>
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="camera_pose_topic" value="no_use0"/>
        <arg name="depth_topic" value="no_use1"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="lidar_p_miss" value="$(arg lidar_p_miss)"/>
        <arg name="cx" value="319.31427001953125"/>
        <arg name="cy" value="239.09725952148438"/>
        <arg name="fx" value="386.2706298828125"/>
        <arg name="fy" value="386.2706298828125"/>
        <!-- 规划速度配置；加速度代价与验收使用上游逻辑 -->
        <arg name="max_vel" value="1.0" />
        <arg name="max_acc" value="0.5" />
        <arg name="max_vel_z" value="0.3"/>
        <arg name="dynamic_tolerance" value="0.05"/>
        <arg name="feasibility_weight" value="10000.0"/>
        <arg name="max_jer" value="10.0"/>
        <arg name="planning_horizon" value="4.0" />
        <arg name="local_map_size_x" value="5.5"/>
        <arg name="local_map_size_y" value="5.5"/>
        <arg name="local_map_size_z" value="2.0"/>
        <arg name="enable_virtual_wall" value="false"/>
        <arg name="virtual_ceil" value="2.5"/>
        <arg name="virtual_ground" value="-0.2"/>
        <arg name="map_resolution" value="$(arg map_resolution)"/>
        <arg name="inflation_size" value="0.35"/>
        <arg name="init_x" value="0"/>
        <arg name="init_y" value="0"/>
        <arg name="init_z" value="0"/>
        <arg name="flight_type" value="1" />
        <arg name="point_num" value="1" />
        <arg name="point0_x" value="1.0" />
        <arg name="point0_y" value="0.0" />
        <arg name="point0_z" value="0.0" />
        <arg name="point1_x" value="0.0" />
        <arg name="point1_y" value="0.0" />
        <arg name="point1_z" value="0.0" />
        <arg name="point2_x" value="0.0" />
        <arg name="point2_y" value="0.0" />
        <arg name="point2_z" value="0.0" />
        <arg name="point3_x" value="0.0" />
        <arg name="point3_y" value="0.0" />
        <arg name="point3_z" value="0.0" />
        <arg name="point4_x" value="0.0" />
        <arg name="point4_y" value="0.0" />
        <arg name="point4_z" value="0.0" />
        <arg name="odom_vel_is_body" value="$(arg odom_vel_is_body)"/>
        <arg name="realworld_experiment" value="false"/>
        <arg name="ground_height" value="-0.10"/>
    </include>

    <!-- 轨迹指令服务器：采样五次多项式输出标准 PositionCommand -->
    <node unless="$(arg manual_preview)" pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="position_cmd" to="$(arg output_cmd_topic)"/>
        <remap from="~planning/trajectory" to="/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/yaw" to="/drone_$(arg drone_id)_planning/yaw"/>
        <remap from="~heartbeat" to="/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <param name="traj_server/yaw_dot_max" value="1.57" type="double"/>
        <param name="traj_server/yaw_dot_dot_max" value="6.28" type="double"/>
    </node>
</launch>
