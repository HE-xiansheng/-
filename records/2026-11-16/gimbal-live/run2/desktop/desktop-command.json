  "location=rtsp://127.0.0.1:11954/gimbal",
  "protocols=tcp",
  "latency=100",
  "drop-on-latency=true",
  "tcp-timeout=5000000",
  "!",
  "rtph264depay",
  "!",
  "h264parse",
  "!",
  "avdec_h264",
  "!",
  "queue",
  "max-size-buffers=1",
  "max-size-bytes=0",
  "max-size-time=0",
  "leaky=downstream",
  "!",
  "videoconvert",
  "!",
  "videoscale",
  "add-borders=true",
  "!",
  "video/x-raw,format=RGB,width=640,height=360,pixel-aspect-ratio=1/1",
  "!",
  "fdsink",
  "fd=1",
  "sync=false"
